<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolEnergyOptimizer.Web</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolEnergyOptimizer.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="site-title" asp-controller="Home" asp-action="Index">SchoolEnergyOptimizer.Web</a>
        <nav>
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </nav>
    </header>
    <main class="site-main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        &copy; 2026 - SchoolEnergyOptimizer.Web - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
